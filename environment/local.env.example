# Copy the relevant values into your shell profile or CI environment. Do not commit local.env.
# Windows example:
# $env:CLETRIS_GODOT_BIN = 'D:\Godot\Engine4_6\godot.exe'
# $env:CLETRIS_JAVA_HOME = 'C:\Program Files\Eclipse Adoptium\jdk-17.0.20.8-hotspot'
# $env:CLETRIS_ANDROID_SDK_ROOT = 'C:\Android\Sdk'
# $env:CLETRIS_TOOLCHAIN_CACHE = "$env:APPDATA\CDevToolchain"
#
# Linux example:
# export CLETRIS_GODOT_BIN="$HOME/.cache/cletris/godot/Godot_v4.6-stable_linux.x86_64"
# export CLETRIS_JAVA_HOME="/usr/lib/jvm/temurin-17-jdk"
# export CLETRIS_ANDROID_SDK_ROOT="$HOME/.cache/cletris/android-sdk"
# export CLETRIS_TOOLCHAIN_CACHE="$HOME/.cache/cletris"
#
# This local-only delivery setting is deliberately separate from build setup:
# $env:CLETRIS_PHONE_BUILDS_DIR = 'G:\My Drive\Cletris Builds'
